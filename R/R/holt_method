library(shiny)
library(forecast)

holt_ui <- function(id) {
  ns <- NS(id)
  tagList(
    h3("Holt Metodu ile Optimum \u03B1 ve \u03B2 Analizi"),
    # Kullanıcının veri girebilmesi için metin kutusu
    textAreaInput(ns("veri_girisi"), "Veri Girin (Virgülle ayırarak):", 
                  value = "200, 250, 175, 186, 225, 285, 305, 190", rows = 2),
    actionButton(ns("hesapla"), "Modeli Çalıştır ve Yorumla", class = "btn-primary"),
    br(), br(),
    
    # Yorumların gösterileceği alan
    verbatimTextOutput(ns("sonuclar")),
    
    # Grafiğin gösterileceği alan
    plotOutput(ns("grafik"))
  )
}

holt_server <- function(id) {
  moduleServer(id, function(input, output, session) {
    
    # Butona tıklandığında hesaplamaları yapacak reaktif blok
    hesaplanan_model <- eventReactive(input$hesapla, {
      
      # 1. Girilen metni sayı vektörüne dönüştürme
      veri_metni <- input$veri_girisi
      veri_vektoru <- as.numeric(unlist(strsplit(veri_metni, ",")))
      veri_vektoru <- veri_vektoru[!is.na(veri_vektoru)] # Hatalı girişleri temizle
      
      # 2. Holt Modelini çalıştırma
      ts_data <- ts(veri_vektoru)
      model <- forecast::holt(ts_data)
      
      # 3. Optimum parametreleri çekme
      best_alpha <- model$model$par["alpha"]
      best_beta  <- model$model$par["beta"]
      acc <- forecast::accuracy(model)
      mad_value <- acc[1, "MAE"] # MAE = MAD
      
      # 4. Parametre Yorumları
      yorum_alfa <- ifelse(best_alpha > 0.5,
                           "Alfa Yüksek (>0.5): Model güncel talebe çok hızlı tepki veriyor, geçmişi çabuk unutuyor.",
                           "Alfa Düşük (<0.5): Model geçmiş verilere güveniyor, seviye (level) güncellemeleri yavaş ve stabil.")
      
      yorum_beta <- ifelse(best_beta > 0.5,
                           "Beta Yüksek (>0.5): Trend (eğim) son değişimlere anında uyum sağlıyor. Çok dinamik bir trend var.",
                           "Beta Düşük (<0.5): Trend değişimi yavaş, uzun vadeli büyüme/küçülme paterni korunuyor.")
      
      # Sonuçları liste olarak döndür
      list(
        model = model,
        metin_cikti = paste0(
          "=== OPTİMİZASYON SONUÇLARI ===\n",
          sprintf("Optimum \u03b1 (Alfa - Seviye): %.4f\n", best_alpha),
          sprintf("Optimum \u03b2 (Beta - Trend) : %.4f\n", best_beta),
          sprintf("Minimum MAD (Ort. Sapma) : %.4f\n\n", mad_value),
          "=== VERİ VE MODEL YORUMU ===\n",
          "- ", yorum_alfa, "\n",
          "- ", yorum_beta
        )
      )
    }, ignoreNULL = FALSE) # Uygulama açılır açılmaz varsayılan veriyle çalışması için
    
    # Metin çıktısını arayüze basma
    output$sonuclar <- renderText({
      req(hesaplanan_model())
      hesaplanan_model()$metin_cikti
    })
    
    # Grafiği arayüze basma
    output$grafik <- renderPlot({
      req(hesaplanan_model())
      m <- hesaplanan_model()$model
      
      plot(m, main="Holt Tahmini ve Gerçek Veri Karşılaştırması",
           ylab="Talep / Veri Değeri", xlab="Zaman", flty=2)
      lines(m$fitted, col="red", lwd=2)
      legend("topleft", legend=c("Gerçek Veri", "Model Uyumu (Fitted)"), 
             col=c("black", "red"), lty=1, lwd=c(1, 2))
    })
    
  })
}
